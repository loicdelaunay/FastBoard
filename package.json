{
  "name": "fastboard",
  "private": true,
  "version": "1.7.1",
  "description": "Suivi de projet collaboratif temps réel (Kanban, Liste, Gantt, Analyseur) — Vue 3, PrimeVue, SQLite, WebSocket",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --no-warnings=ExperimentalWarning server/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "start": "node --no-warnings=ExperimentalWarning server/index.ts",
    "start:prod": "cross-env NODE_ENV=production node --no-warnings=ExperimentalWarning server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --no-warnings=ExperimentalWarning --test \"server/tests/**/*.test.ts\"",
    "seed:demo": "node --no-warnings=ExperimentalWarning server/scripts/seed-demo.ts",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "swagger-ui-dist": "^5.33.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  }
}
